{
  "id": "officer",
  "name": "주무관",
  "portrait": "assets/portraits/officer.jpg",
  "placeId": "lobby",
  "encounters": [
    {
      "id": 1,
      "start": "intro",
      "nodes": {
        "intro": {
          "aside": "폐관 이후. 1층 로비. 그림 하나가 뒤집혀 벽에 기대어 있다.",
          "text": "주무관은 뒤를 보지 않은 채, 액자 각도를 맞추고 있다.",
          "bg": "assets/places/lobby.jpg",
          "next": "n1"
        },
        "n1": {
          "speaker": "주무관",
          "text": "왔어? 좀 도와줘봐.",
          "next": "n2"
        },
        "n2": {
          "speaker": "나",
          "text": "그림이 왜 그래요?",
          "next": "n3"
        },
        "n3": {
          "speaker": "주무관",
          "text": "몰라. 맨날 이래. 문 열면 뒤집혀 있어. 3년쯤 됐나.",
          "next": "n4"
        },
        "n4": {
          "speaker": "주무관",
          "text": "애들 사이에서 유령 있다는 소문도 도는데, 뭐 — 아무도 안 다치잖아.",
          "next": "n5"
        },
        "n5": {
          "speaker": "주무관",
          "text": "아, 맞다. 3번 칸 뚜껑도 좀 봐줄래? 그것도 맨날 열려있어.",
          "next": "n6"
        },
        "n6": {
          "aside": "그림을 다시 건다. 뒷면에 연필 자국이 남아 있다.",
          "text": "앞면은 노란 소용돌이다. 뒷면은, 거의 지워진 한 줄이다.",
          "bg": "assets/places/lobby.jpg",
          "next": "n7"
        },
        "n7": {
          "speaker": "나",
          "text": "뒤에… 뭐가 적혀 있는데요.",
          "next": "n8"
        },
        "n8": {
          "speaker": "주무관",
          "text": "그래? 나는 앞면만 보고 걸어서 몰랐네.",
          "next": "n9"
        },
        "n9": {
          "speaker": "주무관",
          "text": "글씨 보여. 뭐라고 써 있어.",
          "next": "n10"
        },
        "n10": {
          "aside": "연필 자국. 거의 지워져 있다.",
          "text": "오늘도 아닌 문.",
          "next": "n11"
        },
        "n11": {
          "speaker": "나",
          "text": "…오늘도 아닌 문, 이래요.",
          "next": "n12"
        },
        "n12": {
          "speaker": "주무관",
          "text": "애들 낙서지. 3번 칸도 낙서투성이야. 가서 뚜껑이나 닫아.",
          "next": "n13"
        },
        "n13": {
          "aside": "화장실 3번 칸. 뚜껑이 열려 있다.",
          "text": "벽의 물자국이, 보는 각도에 따라 얼굴처럼 보이기도 하고 그냥 물이기도 하다.",
          "bg": "assets/places/stall.jpg",
          "next": "n14"
        },
        "n14": {
          "speaker": "주무관",
          "text": "닫았어? 불 끄고 나가자. 열쇠는 네가 갖고 있지.",
          "next": "n15"
        },
        "n15": {
          "speaker": "주무관",
          "text": "마감이잖아. 야간 알바. 진로는 아직 없어도, 열쇠는 있지.",
          "next": "n16"
        },
        "n16": {
          "aside": "로비 불이 하나 꺼진다. 그림은 바로 걸려 있다.",
          "text": "닫아도 내일 다시 열려 있을 것 같은 예감이 든다. 그림도, 뚜껑도.",
          "bg": "assets/places/lobby.jpg",
          "choices": [
            { "text": "오늘 밤에 다시 와볼게요.", "next": "n17a" },
            { "text": "일단 뚜껑만 닫을게요.", "next": "n17b" }
          ]
        },
        "n17a": {
          "speaker": "주무관",
          "text": "야. 불 꺼지면 단서고 뭐고 발등이나 찍어. 그냥 가.",
          "next": "n18a"
        },
        "n18a": {
          "speaker": "나",
          "text": "그래도요.",
          "next": "n19a"
        },
        "n19a": {
          "speaker": "주무관",
          "text": "…열쇠 떨어뜨리지 마. 나는 앞면만 보고 살거든.",
          "end": true
        },
        "n17b": {
          "speaker": "주무관",
          "text": "그래, 그게 맞지. 뚜껑 닫고 퇴근.",
          "next": "n18b"
        },
        "n18b": {
          "aside": "뚜껑은 닫혔다. 물자국은 그대로다.",
          "text": "닫아도, 내일 아침이면 다시 열려 있을 것 같다.",
          "next": "n19b"
        },
        "n19b": {
          "speaker": "주무관",
          "text": "뭐야, 얼굴이. 밤에 몰래 들어오려고. 하지 마. 진짜로.",
          "end": true
        }
      }
    }
  ]
}
